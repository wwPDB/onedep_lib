save_pdbx_deposition_rule_param
  _category.description
;  The category provides name/value parameters for procedural and aggregate rules.
;
  _category.id               pdbx_deposition_rule_param
  _category.mandatory_code   no
  loop_
  _category_key.name         '_pdbx_deposition_rule_param.rule_id'
                             '_pdbx_deposition_rule_param.name'
  loop_
  _category_group.id         'inclusive_group'
                             'pdbx_group'
  loop_
  _category_examples.detail
  _category_examples.case
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
;
    Example 1
;
;
    loop_
    _pdbx_deposition_rule_param.rule_id
    _pdbx_deposition_rule_param.name
    _pdbx_deposition_rule_param.value
    R004 group_by      _atom_site.label_atom_id+_atom_site.label_comp_id+_atom_site.label_asym_id+_atom_site.label_seq_id
    R004 aggregate     SUM
    R004 threshold     1.0
;
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    _pdbx_category_context.type         CONTRIBUTED
    _pdbx_category_context.category_id  pdbx_deposition_rule_param

     save_

