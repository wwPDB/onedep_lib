save_pdbx_deposition_rule
  _category.description
;  Data items in PDBX_DEPOSITION_RULE define deposition rules. One record per rule. 
;
  _category.id               pdbx_deposition_rule
  _category.mandatory_code   no
  loop_
  _category_key.name         '_pdbx_deposition_rule.id'
  loop_
  _category_group.id         'inclusive_group'
                             'pdbx_group'
  loop_
  _category_examples.detail
  _category_examples.case
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
;
    Example 1
;
;
    loop_
    _pdbx_deposition_rule.id
    _pdbx_deposition_rule.family
    _pdbx_deposition_rule.severity
    _pdbx_deposition_rule.scope_category
    _pdbx_deposition_rule.procedural_method
    _pdbx_deposition_rule.message
    _pdbx_deposition_rule.enabled
    _pdbx_deposition_rule.param_flag
    _pdbx_deposition_rule.join_flag
    _pdbx_deposition_rule.row_selection_flag
    R001 conditional_presence error   diffrn_radiation_wavelength . 'Wavelength required for X-ray experiments' YES NO NO NO
    R002 pairwise_order       error   pdbx_audit_revision_history . 'Release date precedes deposition date' YES NO NO NO
    R003 format               warning pdbx_initial_refinement_model . 'Accession code does not match source database format' YES NO NO NO
    R004 aggregate            warning atom_site              . 'Summed occupancy of alt-locs exceeds 1.0' YES YES NO NO
    R005 procedural           warning entity_poly            seq_model_mismatch 'Sequence does not match modeled residues' YES NO NO NO
    R006 conditional_presence error   em_sample_support      . 'Grid type required when support film details are given' YES NO YES NO
    R007 pairwise_order       error   reflns                 . 'Collected data high-resolution limit is lower than high-resolution limit used in refinement' YES NO YES NO
    R008 pairwise_order       error   refine_ls_shell        . 'Highest-resolution shell limit does not match overall refined high-resolution limit' YES NO YES YES
    R009 pairwise_order       warning refine                 . 'Overall R_free is higher than R_free in the highest-resolution shell' YES NO YES YES
;
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    _pdbx_category_context.type         CONTRIBUTED
    _pdbx_category_context.category_id  pdbx_deposition_rule

     save_

