###########################################
## DEPOSITION RULES EXTENSION DICTIONARY ##
###########################################

data_mmcif_pdbx_deposition_rules_ext.dic

loop_
_item_type_list.code
_item_type_list.primitive_code
_item_type_list.construct
_item_type_list.detail
               alphanum-csv     uchar
               '[0-9A-Za-z ]+(?:\s*,\s*[0-9A-Za-z ]+)*'
               "comma separated alphanumeric codes (no spaces)  ..."

##########################
## PDBX_DEPOSITION_RULE ##
##########################

save_pdbx_deposition_rule
  _category.description
;  Data items in PDBX_DEPOSITION_RULE define deposition rules. One record per rule. 
;
  _category.id               pdbx_deposition_rule
  _category.mandatory_code   no
  loop_
  _category_key.name         '_pdbx_deposition_rule.id'
  loop_
  _category_group.id         'inclusive_group'
                             'pdbx_group'
  loop_
  _category_examples.detail
  _category_examples.case
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
;
    Example 1
;
;
    loop_
    _pdbx_deposition_rule.id
    _pdbx_deposition_rule.family
    _pdbx_deposition_rule.severity
    _pdbx_deposition_rule.scope_category
    _pdbx_deposition_rule.procedural_method
    _pdbx_deposition_rule.message
    _pdbx_deposition_rule.enabled
    _pdbx_deposition_rule.param_flag
    R001 conditional_presence error   exptl                  . 'Wavelength required for X-ray experiments' YES NO
    R002 pairwise_order       error   pdbx_audit_revision_history . 'Release date precedes deposition date' YES NO
    R003 format               warning pdbx_initial_refinement_model . 'Accession code does not match source database format' YES NO
    R004 aggregate            warning atom_site              . 'Summed occupancy of alt-locs exceeds 1.0' YES YES
    R005 procedural           warning entity_poly            seq_model_mismatch 'Sequence does not match modeled residues' YES NO
;
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    _pdbx_category_context.type         CONTRIBUTED
    _pdbx_category_context.category_id  pdbx_deposition_rule

     save_

save__pdbx_deposition_rule.id
    _item_description.description
;    A unique identifier for the deposition rule.
;
  _item.name               '_pdbx_deposition_rule.id'
  _item.category_id        pdbx_deposition_rule
  _item.mandatory_code     yes
  _item_type.code          code
   save_

save__pdbx_deposition_rule.family
    _item_description.description
;    Deposition rule family.
;
  _item.name               '_pdbx_deposition_rule.family'
  _item.category_id        pdbx_deposition_rule
  _item.mandatory_code     yes
  _item_type.code          code
  loop_
  _item_enumeration.value
  _item_enumeration.detail
    conditional_presence  'THEN items must be present/non-empty if WHEN holds'
    conditional_value     'THEN items must satisfy operator if WHEN holds'
    pairwise_order        'ordering between two items (dates, numbers)'
    uniqueness            'values unique within category (composite allowed)'
    cross_reference       'value must exist/match in another category'
    format                'value must match a pattern'
    aggregate             'sum/count over a group compared to a threshold'
    procedural            'named built-in check; see _pdbx_deposition_rule_param'
   save_

save__pdbx_deposition_rule.severity
    _item_description.description
;    Deposition rule severity.
;
  _item.name               '_pdbx_deposition_rule.severity'
  _item.category_id        pdbx_deposition_rule
  _item.mandatory_code     yes
  _item_type.code          ucode
  loop_
  _item_enumeration.value
    ERROR
    WARNING
    INFO
   save_

save__pdbx_deposition_rule.message
    _item_description.description
;    Deposition rule message.
;
  _item.name               '_pdbx_deposition_rule.message'
  _item.category_id        pdbx_deposition_rule
  _item.mandatory_code     yes
  _item_type.code          text
   save_

save__pdbx_deposition_rule.scope_category
    _item_description.description
;    Category in which each violation is assessed and reported. 
;
  _item.name               '_pdbx_deposition_rule.scope_category'
  _item.category_id        pdbx_deposition_rule
  _item.mandatory_code     yes
  _item_type.code          code
   save_

save__pdbx_deposition_rule.procedural_method
    _item_description.description
;    Deposition rule procedural method.
;
  _item.name               '_pdbx_deposition_rule.procedural_method'
  _item.category_id        pdbx_deposition_rule
  _item.mandatory_code     no
  _item_type.code          code
  loop_
  _item_examples.case
    occupancy_sum_gt_1
    seq_model_mismatch
   save_

save__pdbx_deposition_rule.enabled
    _item_description.description
;    Flag to enable/disable the deposition rule.
; 
  _item.name               '_pdbx_deposition_rule.enabled'
  _item.category_id        pdbx_deposition_rule
  _item.mandatory_code     no
  _item_type.code          ucode
  _item_default.value      YES
  loop_
  _item_enumeration.value
    YES
    NO
   save_

save__pdbx_deposition_rule.param_flag
    _item_description.description
;    Flag for additional parameters for the deposition rule.
;
  _item.name               '_pdbx_deposition_rule.param_flag'
  _item.category_id        pdbx_deposition_rule
  _item.mandatory_code     no
  _item_type.code          ucode
  loop_
  _item_enumeration.value
    YES
    NO
   save_

####################################
## PDBX_DEPOSITION_RULE_CONDITION ##
####################################

save_pdbx_deposition_rule_condition
  _category.description
;  This category describes the WHEN / THEN / UNLESS clauses of a rule.
;
  _category.id               pdbx_deposition_rule_condition
  _category.mandatory_code   no
  loop_
  _category_key.name        '_pdbx_deposition_rule_condition.rule_id'
                            '_pdbx_deposition_rule_condition.ordinal'
    loop_
    _category_group.id           'inclusive_group'
                                 'pdbx_group'
    loop_
    _category_examples.detail
    _category_examples.case
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
;
    Example 1
;
;
    loop_
    _pdbx_deposition_rule_condition.rule_id
    _pdbx_deposition_rule_condition.ordinal
    _pdbx_deposition_rule_condition.role
    _pdbx_deposition_rule_condition.item_name
    _pdbx_deposition_rule_condition.operator
    _pdbx_deposition_rule_condition.value
    _pdbx_deposition_rule_condition.other_item_name
    _pdbx_deposition_rule_condition.group_operator
    R001 1 WHEN _exptl.method                               EQ         'X-RAY DIFFRACTION' . .
    R001 2 THEN _diffrn_radiation_wavelength.wavelength     NOT_EMPTY  .                   . .
    R002 1 THEN _pdbx_audit_revision_history.revision_date  GE_ITEM    .                   _pdbx_database_status.recvd_initial_deposition_date .
    R003 1 WHEN _pdbx_initial_refinement_model.source_name  EQ         PDB                 . .
    R003 2 THEN _pdbx_initial_refinement_model.accession_code MATCHES  '^[0-9][A-Za-z0-9]{3}$' . .
    R004 1 THEN _atom_site.occupancy                        LE         1.0                 . .
;
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    _pdbx_category_context.type         CONTRIBUTED
    _pdbx_category_context.category_id  pdbx_deposition_rule_condition

     save_

save__pdbx_deposition_rule_condition.rule_id
    _item_description.description
;    A pointer to _pdbx_deposition_rule.id. 
; 
  _item.name               '_pdbx_deposition_rule_condition.rule_id'
  _item.category_id        pdbx_deposition_rule_condition
  _item.mandatory_code     yes
  _item_type.code          code
  _item_linked.child_name  '_pdbx_deposition_rule_condition.rule_id'
  _item_linked.parent_name '_pdbx_deposition_rule.id'
   save_

save__pdbx_deposition_rule_condition.ordinal
    _item_description.description
;    An identifier for the rule condition.  
;
  _item.name               '_pdbx_deposition_rule_condition.ordinal'
  _item.category_id        pdbx_deposition_rule_condition
  _item.mandatory_code     yes
  _item_type.code          int
   save_

save__pdbx_deposition_rule_condition.role
    _item_description.description
;    Primary role for the rule condition. 
;
  _item.name               '_pdbx_deposition_rule_condition.role'
  _item.category_id        pdbx_deposition_rule_condition
  _item.mandatory_code     yes
  _item_type.code          ucode
  loop_
  _item_enumeration.value
    WHEN
    THEN
    UNLESS
   save_

save__pdbx_deposition_rule_condition.item_name
    _item_description.description
;    Full item name where the rule condition applies.
     Must be an item name defined in the main dictionary. 
;
  _item.name               '_pdbx_deposition_rule_condition.item_name'
  _item.category_id        pdbx_deposition_rule_condition
  _item.mandatory_code     yes
  _item_type.code          code
   save_

save__pdbx_deposition_rule_condition.operator
    _item_description.description
;    Operator for the rule condition
;
  _item.name               '_pdbx_deposition_rule_condition.operator'
  _item.category_id        pdbx_deposition_rule_condition
  _item.mandatory_code     yes
  _item_type.code          ucode
  loop_
  _item_enumeration.value
    EXISTS
    NOT_EXISTS
    EMPTY
    NOT_EMPTY
    EQ
    NE
    LT
    LE
    GT
    GE
    IN
    NOT_IN
    MATCHES
    NOT_MATCHES
    EQ_ITEM
    LE_ITEM
    GE_ITEM
    LT_ITEM
    GT_ITEM
    UNIQUE
    IN_COLUMN_OF
   save_

save__pdbx_deposition_rule_condition.value
    _item_description.description
;    Comma-separated lis of value corresponding the rule condition.
     Can be a single value, regex, or a list of enumerations.
;
  _item.name               '_pdbx_deposition_rule_condition.value'
  _item.category_id        pdbx_deposition_rule_condition
  _item.mandatory_code     no
  _item_type.code          alphanum-csv
  loop_
  _item_examples.case
   'X-RAY DIFFRACTION'
   'PDB'
   'ELECTRON MICROSCOPY, ELECTRON CRYSTALLOGRAPHY'
   save_

save__pdbx_deposition_rule_condition.other_item_name
    _item_description.description
;    Full item name of the second item involved in the rule.
     Applies for cases where operators are *_ITEM and IN_COLUMN_OF. 
     Must be an item name defined in the main dictionary.
;
  _item.name               '_pdbx_deposition_rule_condition.other_item_name'
  _item.category_id        pdbx_deposition_rule_condition
  _item.mandatory_code     no
  _item_type.code          code
   save_

save__pdbx_deposition_rule_condition.group_operator
    _item_description.description
;    Deposition rule condition group operator.
     Allows combining rule conditions expressed in multiple rows. 
     Applies mainly for required_if_any_present. 
;
  _item.name               '_pdbx_deposition_rule_condition.group_operator'
  _item.category_id        pdbx_deposition_rule_condition
  _item.mandatory_code     no
  _item_type.code          ucode
  _item_default.value      AND
  loop_
  _item_enumeration.value
    AND
    OR
   save_

